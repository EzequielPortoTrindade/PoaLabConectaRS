// prisma/schema.prisma
// Para alternar entre bancos: mude o provider e DATABASE_URL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // troque por "mongodb" para testes locais com Prisma+Mongo
  url      = env("DATABASE_URL")
}

enum TipoUsuario {
  admin
  professor
}

enum TipoContato {
  telefone
  whatsapp
}

enum TipoCategoria {
  capital
  custeio
}

enum TipoMovimentacaoLog {
  entrada
  saida
}

model Localizacao {
  id_localizacao Int      @id @default(autoincrement())
  nome_cidade    String   @db.VarChar(100)
  escolas        Escola[]
}

model Escola {
  id_escola      Int          @id @default(autoincrement())
  nome           String       @db.VarChar(150)
  rua            String?      @db.VarChar(100)
  numero         Int?
  bairro         String?      @db.VarChar(100)
  uf             String?      @db.VarChar(2)
  id_localizacao Int?
  localizacao    Localizacao? @relation(fields: [id_localizacao], references: [id_localizacao])
  usuarios       Usuario[]
  itens          Item[]
  compras        Compras[]
}

model Usuario {
  id_usuario    Int         @id @default(autoincrement())
  nome          String      @db.VarChar(100)
  email         String      @unique @db.VarChar(100)
  tipo          TipoUsuario
  id_escola     Int?
  escola        Escola?     @relation(fields: [id_escola], references: [id_escola])
  logs          LogMovimentacao[]
}

model Fornecedor {
  id_fornecedor Int       @id @default(autoincrement())
  nome          String    @db.VarChar(100)
  endereco      String?   @db.VarChar(150)
  website       String?   @db.VarChar(100)
  contatos      Contato[]
  compras       Compras[]
}

model Contato {
  id_contato    Int         @id @default(autoincrement())
  fornecedor_id Int
  tipo          TipoContato
  numero        String      @db.VarChar(20)
  fornecedor    Fornecedor  @relation(fields: [fornecedor_id], references: [id_fornecedor])
}

model Tipo {
  id_tipo   Int           @id @default(autoincrement())
  nome      String        @db.VarChar(100)
  categoria TipoCategoria
  descricao String?       @db.VarChar(150)
  itens     Item[]
}

model Item {
  id_item   Int      @id @default(autoincrement())
  quantidade Int
  descricao  String?  @db.VarChar(150)
  id_tipo    Int?
  id_escola  Int?
  tipo       Tipo?    @relation(fields: [id_tipo], references: [id_tipo])
  escola     Escola?  @relation(fields: [id_escola], references: [id_escola])
  compras    Compras[]
  logs       LogMovimentacao[]
}

model Compras {
  id_compras    Int        @id @default(autoincrement())
  id_item       Int?
  id_fornecedor Int?
  id_escola     Int?
  quantidade    Int
  data_compra   DateTime?  @db.Date
  valor_unitario Decimal?  @db.Decimal(10, 2)
  marca         String?    @db.VarChar(40)
  nota_fiscal   String?    @db.VarChar(50)
  item          Item?      @relation(fields: [id_item], references: [id_item])
  escola        Escola?    @relation(fields: [id_escola], references: [id_escola])
  fornecedor    Fornecedor? @relation(fields: [id_fornecedor], references: [id_fornecedor])
}

model LogMovimentacao {
  id_log             Int                 @id @default(autoincrement())
  id_item            Int?
  id_usuario         Int?
  tipo_movimentacao  TipoMovimentacaoLog
  quantidade         Int?
  data_hora          DateTime            @default(now())
  motivo             String?             @db.VarChar(150)
  item               Item?               @relation(fields: [id_item], references: [id_item])
  usuario            Usuario?            @relation(fields: [id_usuario], references: [id_usuario])
}
