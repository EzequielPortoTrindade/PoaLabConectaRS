{
  "name": "inv-escolar",
  "private": true,
  "scripts": {
    "prisma:prepare": "pnpm --filter back exec prisma generate && pnpm --filter back exec prisma migrate dev",
    "dev:front": "pnpm --filter front dev",
    "dev:back": "pnpm --filter back dev",
    "dev:parallel": "pnpm -r --parallel dev",
    "dev": "pnpm prisma:prepare && pnpm dev:parallel"
  },
  "dependencies": {
    "pnpm": "^11.9.0"
  }
}
